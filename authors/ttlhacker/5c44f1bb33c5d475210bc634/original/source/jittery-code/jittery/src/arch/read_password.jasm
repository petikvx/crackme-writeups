#define PASSWORD_LENGTH_MAX 128

//uint64_t * read_password(void)
//Returns a pointer to the password on success, 0 on failure
label read_password
	push $lr
	push $a0
	push $a1
	
	ldi $a1, PASSWORD_LENGTH_MAX
	vmcall VC_MALLOC: $a0, $a1, $a1
	ldi $rv, 0
	jz $a0, read_password_end
	
	call gets
	addi $rv, $a0, 0
	
label read_password_end
	pop $a1
	pop $a0
	pop $lr
	jr $lr

