WEnd
Func _CHECK ( $USERNAME )
	Local $S1 = 0 , $S2 = 0 , $S3 = 0 , $S4 = 1
	$R = StringLen ( $USERNAME )
	$S2 = StringLeft ( $USERNAME , 3 )
	$S2 = StringUpper ( $S2 )
	For $I = 1 To $R Step + 1
		$S1 += Asc ( StringLeft ( $USERNAME , 1 ) )
		$S3 -= Asc ( StringLeft ( $USERNAME , 1 ) )
		$S4 /= Asc ( StringLeft ( $USERNAME , 1 ) )
		$USERNAME = StringTrimLeft ( $USERNAME , 1 )
	Next
	$SERIAL = $S1 & "-" & $S2 & $S3 & "-" & $S4
	$ENTEREDSERIAL = GUICtrlRead ( $INPUT2 )
	If $R < 3 Then
		GUICtrlSetData ( $STATUS , "Name should be atleast 3 char long." )
		GUICtrlSetColor ( $STATUS , 16711680 )
	ElseIf $ENTEREDSERIAL == "" Then
		GUICtrlSetData ( $STATUS , "Are you nuts ?" )
		GUICtrlSetColor ( $STATUS , 32768 )
	ElseIf $ENTEREDSERIAL <> "" Then
		If $ENTEREDSERIAL == $SERIAL Then
			GUICtrlSetData ( $STATUS , "Well Done !!" )
			GUICtrlSetColor ( $STATUS , 32768 )
			MsgBox ( 64 , "Well Done!" , "Serial was correct, Now write a keygen and send it to me with its full source, if you want the source of this crackme and keygen made by me." & @CRLF & @CRLF & "MightyKing.Tools@gmail.com" )
		Else
			GUICtrlSetData ( $STATUS , "Wrong serial :( , Keep tryin'" )
			GUICtrlSetColor ( $STATUS , 16711680 )
		EndIf
	EndIf
EndFunc
